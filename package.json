{
  "name": "interactive-portfolio-ai-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:worker": "vitest run apps/guide-api/src/index.test.ts",
    "worker:dev": "wrangler dev --config apps/guide-api/wrangler.jsonc",
    "worker:types": "wrangler types apps/guide-api/worker-configuration.d.ts --config apps/guide-api/wrangler.jsonc",
    "content:validate": "node scripts/agentic-architect/validate-approved-corpus.mjs",
    "eval:grounding": "node scripts/agentic-architect/run-grounding-evals.mjs",
    "test:static-export": "node scripts/verify-static-export.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
